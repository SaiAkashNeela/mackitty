# Used by script/package_and_notarize_local.sh (copy to .env, never commit .env).
# Apple ID that owns the Developer ID certificate
APPLE_ID=you@example.com
# 10-character Apple Developer Team ID
APPLE_TEAM_ID=XXXXXXXXXX
# App-specific password from appleid.apple.com (Sign-In and Security > App-Specific Passwords)
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
